{
    "name": "guikingone/agent-skills",
    "type": "library",
    "license": "MIT",
    "description": "A library that integrate agent skills standard",
    "authors": [
        {
            "name": "Guillaume Loulier",
            "email": "contact@guillaumeloulier.fr",
            "homepage": "https://www.guillaumeloulier.fr/"
        }
    ],
    "prefer-stable": true,
    "config": {
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "AgentSkills\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AgentSkills\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "symfony/clock": "^7.4|^8.0",
        "symfony/filesystem": "^7.4|^8.0",
        "symfony/finder": "^7.4|^8.0",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/string": "^7.4|^8.0"
    },
    "suggest": {
        "laravel/ai": "Required for the Laravel AI bridge",
        "neuron-core/neuron-ai": "Required for the Neuron AI bridge",
        "symfony/ai-agent": "Required for the Symfony AI bridge"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "laravel/ai": "^0.3",
        "neuron-core/neuron-ai": "^3.2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.3",
        "symfony/ai-agent": "^0.6.0",
        "symfony/config": "^7.4|^8.0",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4|^8.0"
    }
}
